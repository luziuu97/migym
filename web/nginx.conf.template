# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Apple Associated Domains (passkeys in the native iOS WebView). Must not fall
    # through to index.html, and must be served as JSON with no file extension.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        add_header Cache-Control "no-cache";
    }

    # API → backend. Variable proxy_pass + Railway's private DNS (fd12::10)
    # so nginx re-resolves after the API redeploys; a static upstream would
    # keep the old replica IP forever. Compose has no fd12::10 — 127.0.0.11
    # is Docker's embedded DNS and is ignored if missing.
    location /api/ {
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${BACKEND}:${BACKEND_PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
